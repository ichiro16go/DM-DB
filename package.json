{
  "name": "dm-card-db",
  "version": "0.1.0",
  "description": "Duel Masters card database: crawler, SQLite DB, search engine, web UI and MCP server",
  "scripts": {
    "test": "vitest run",
    "crawl": "tsx src/crawl/crawl.ts",
    "build:db": "tsx src/db/build-cli.ts",
    "serve": "tsx src/server/index.ts",
    "mcp": "tsx src/mcp/server.ts",
    "typecheck": "tsc -p . && tsc -p web",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"web/src/**/*.{ts,tsx,css}\"",
    "update": "tsx src/crawl/crawl.ts --refresh=master,lists,all,abilities,regulation && tsx src/db/build-cli.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "start": "node --enable-source-maps dist/server/index.js",
    "job:update": "tsx src/jobs/update.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "meta": "tsx src/meta/cli.ts",
    "job:meta": "tsx src/jobs/meta-update.ts"
  },
  "type": "module",
  "dependencies": {
    "@google-cloud/storage": "^9.0.0",
    "@hono/node-server": "^2.1.11",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.2.0",
    "cheerio": "^1.2.0",
    "hono": "^4.13.21",
    "undici": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "private": true
}
